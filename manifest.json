{
  "manifest_version": 3,
  "name": "DSA Tracker Companion",
  "version": "1.0.0",
  "description": "Companion extension for tracking DSA progress.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "identity"
  ],
  "oauth2": {
    "client_id": "904583871536-0ac6cd2j1o7ddsmvnrokiftrkgbnb0jn.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile"
    ]
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "extension/sidepanel.html"
  },
  "action": {
    "default_title": "Open DSA Tracker"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Comma",
        "mac": "MacCtrl+Comma"
      },
      "description": "Open DSA Tracker side panel"
    }
  }
}
